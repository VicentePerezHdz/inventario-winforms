<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <configSections>
  </configSections>
  <connectionStrings>
    <!-- Ajusta el servidor a tu instancia local de SQL Server. Se usa autenticación de Windows: sin usuarios ni contraseñas en el código. -->
    <add name="Inventario.Properties.Settings.InventarioConnectionString"
      connectionString="Data Source=.\SQLEXPRESS;Initial Catalog=Inventario;Integrated Security=True"
      providerName="System.Data.SqlClient" />
  </connectionStrings>
  <appSettings>
    <add key="SistemaConnectionString" value="Data Source=.\SQLEXPRESS;Initial Catalog=Inventario;Integrated Security=True;Pooling=true;Min Pool Size=0;Max Pool Size=90;Connect Timeout=5"/>
  </appSettings>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
  </startup>
</configuration>
